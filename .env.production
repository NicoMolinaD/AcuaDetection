# AcuaDetection - Configuración de Producción

# Dominio y Email (CAMBIAR ESTOS VALORES)
DOMAIN_NAME=aquadetection.local
EMAIL=admin@aquadetection.local

# PostgreSQL
POSTGRES_USER=aquadetection
POSTGRES_PASSWORD=aquadetection_secure_pass
POSTGRES_DB=aquadetection_db

# Backend
DATABASE_URL=postgresql://aquadetection:aquadetection_secure_pass@db:5432/aquadetection_db
SECRET_KEY=change_this_to_a_secure_random_key

# API Keys Configuration
